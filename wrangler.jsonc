{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krumath-tugofwar",
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUG_ROOMS",
        "class_name": "TugRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TugRoom"],
    },
  ],
}
