# Supabase Auth (optional for local DEV — auth gate is skipped in Vite DEV).
# These are public client values (anon key), but never commit real project secrets.
# Vite embeds VITE_* at build time; change them → rebuild + redeploy.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: host site origin for sign-in / home redirects (e.g. local KruMath).
# VITE_HOST_ORIGIN=http://localhost:3000
# Legacy alias still supported:
# VITE_KRUMATH_ORIGIN=http://localhost:3000

# Optional: cookie Domain attribute for shared SSO (e.g. .krumath.com).
# Leave unset for same-host cookies only.
# VITE_AUTH_COOKIE_DOMAIN=.krumath.com
